# Keep internal working documents and tooling out of the published site.
#
# GitHub Pages builds its upload tree with `git archive HEAD`, which honors
# export-ignore. Cloudflare Workers applies the equivalent boundary from
# .assetsignore because its remote build runs `npx wrangler deploy` directly.
# These files stay tracked in git — useful locally and to agents — but are not
# uploaded to anavanzin.com.
#
# Verify with:  git archive HEAD | tar -t | grep -c '^docs/superpowers'   -> 0

# Operational notes: contained local filesystem paths (/Users/ana/...), git and
# PR instructions. Was served publicly and rendered in the poster room until #69.
# The file is deleted on this branch; the rule stays as a guard against its return.
docs/WORKFLOW.md export-ignore

# Implementation plans and design specs written during development.
docs/superpowers export-ignore
docs/superpowers/** export-ignore

# Agent scaffolding, skills, plans and session state.
.agents export-ignore
.agents/** export-ignore
.claude export-ignore
.claude/** export-ignore
.superpowers export-ignore
.superpowers/** export-ignore

