# Cloudflare Workers static-asset headers.
# https://developers.cloudflare.com/workers/static-assets/headers/
# Applied only to asset responses (this Worker has no `main` script).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Font binaries change names when their files change; cache them immutably.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet keeps a stable URL and must be allowed to revalidate.
/fonts/fonts.css
  Cache-Control: public, max-age=3600, must-revalidate

# Vendored filenames are stable, but their contents can change on upgrades.
/vendor/*
  Cache-Control: public, max-age=604800, must-revalidate

# Keep workers.dev preview URLs out of search indexes.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
